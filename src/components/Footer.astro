---
import { EMAIL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="border-t bg-muted">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
	>
		<p>&copy; {today.getFullYear()} {SITE_TITLE}</p>
		<a href={`mailto:${EMAIL}`} class="hover:text-link hover:underline">{EMAIL}</a>
	</div>
</footer>
