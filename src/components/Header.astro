---
import { buttonClass } from '@/lib/ui';
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
	{ href: '/', label: 'Home', icon: 'lucide:house' },
	{ href: '/about', label: 'About', icon: 'lucide:user' },
	{ href: '/projects', label: 'Projects', icon: 'lucide:folder-git-2' },
	{ href: '/contact', label: 'Contact', icon: 'lucide:mail' },
] as const;

const social = [
	{ href: LINKEDIN_URL, label: 'LinkedIn', icon: 'fa6-brands:linkedin' },
	{ href: GITHUB_URL, label: 'GitHub', icon: 'simple-icons:github' },
] as const;

// "/projects/patroli/" counts as being in "/projects"; "/" only matches the home page
const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const navLink = 'inline-flex items-center gap-2 rounded-lg px-2.5 transition-colors hover:bg-accent hover:text-foreground';
---

<header class="sticky top-0 z-40 border-b bg-muted">
	<div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8">
		<a href="/" class="font-bold whitespace-nowrap">{SITE_TITLE}</a>

		<!-- Desktop (lg and up) -->
		<nav aria-label="Main" class="hidden flex-1 justify-center gap-1 lg:flex">
			{
				nav.map(({ href, label, icon }) => (
					<a
						href={href}
						aria-current={isActive(href) ? 'page' : undefined}
						class:list={[
							navLink,
							'h-8 text-sm',
							isActive(href) ? 'bg-accent font-bold text-foreground' : 'text-muted-foreground',
						]}
					>
						<Icon name={icon} class="size-4" />
						{label}
					</a>
				))
			}
		</nav>

		<div class="hidden items-center gap-1 lg:flex">
			{
				social.map(({ href, label, icon }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={label}
						data-tooltip={label}
						class={buttonClass({ variant: 'ghost', size: 'icon' })}
					>
						<Icon name={icon} class="size-5" />
					</a>
				))
			}
			<span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
			<ThemeToggle name="theme-desktop" />
		</div>

		<!-- Mobile: opens the sidebar below -->
		<button
			type="button"
			data-menu-open
			aria-label="Open menu"
			aria-haspopup="dialog"
			aria-controls="mobile-nav"
			class:list={['ml-auto lg:hidden', buttonClass({ variant: 'ghost', size: 'icon-lg' })]}
		>
			<Icon name="lucide:menu" class="size-5" />
		</button>
	</div>
</header>

<!--
	Mobile sidebar: a native <dialog> opened with showModal(), which gives focus trapping, Esc to close
	and a backdrop for free. Slide-in animation and scroll lock are in global.css (.sheet).
-->
<dialog
	id="mobile-nav"
	aria-label="Site navigation"
	class="sheet inset-y-0 right-0 left-auto m-0 h-dvh max-h-dvh w-72 max-w-[85vw] border-l bg-popover p-0 text-popover-foreground shadow-lg"
>
	<div class="flex h-full flex-col">
		<div class="flex items-center justify-between border-b py-2 pr-2 pl-4">
			<span class="font-bold">{SITE_TITLE}</span>
			<button type="button" data-menu-close aria-label="Close menu" class={buttonClass({ variant: 'ghost', size: 'icon-lg' })}>
				<Icon name="lucide:x" class="size-5" />
			</button>
		</div>

		<nav aria-label="Main" class="flex flex-col gap-1 p-3">
			{
				nav.map(({ href, label, icon }) => (
					<a
						href={href}
						aria-current={isActive(href) ? 'page' : undefined}
						class:list={[
							navLink,
							'h-10',
							isActive(href) ? 'bg-accent font-bold text-foreground' : 'text-muted-foreground',
						]}
					>
						<Icon name={icon} class="size-4" />
						{label}
					</a>
				))
			}
		</nav>

		<!-- No hover on touch screens, so the sidebar shows labels next to the icons instead of tooltips -->
		<div class="flex flex-col gap-1 border-t p-3">
			{
				social.map(({ href, label, icon }) => (
					<a href={href} target="_blank" rel="noopener noreferrer" class:list={[navLink, 'h-10']}>
						<Icon name={icon} class="size-4" />
						{label}
					</a>
				))
			}
		</div>

		<div class="mt-auto flex items-center justify-between border-t p-4">
			<span class="text-sm text-muted-foreground">Theme</span>
			<ThemeToggle name="theme-mobile" />
		</div>
	</div>
</dialog>

<script>
	const dialog = document.getElementById('mobile-nav') as HTMLDialogElement;
	document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog.showModal());
	dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
	// A click on the backdrop targets the <dialog> itself (the panel's content fills it edge to edge)
	dialog.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
	// Close if the window is resized to desktop width while the sidebar is open
	matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
		if (event.matches) dialog.close();
	});
</script>
