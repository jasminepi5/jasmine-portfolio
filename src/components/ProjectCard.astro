---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	project: CollectionEntry<'project'>;
	/** Keeps the heading outline correct: h2 directly under a page h1, h3 under a section h2 */
	headingLevel?: 2 | 3;
	/** Load the image straight away instead of lazily (for cards near the top of a page) */
	eager?: boolean;
};

const { 
	project, 
	headingLevel = 3, 
	eager = false 
} = Astro.props;

const { 
	title, 
	type, 
	description, 
	heroImage, 
	techStack 
} = project.data;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<!-- Bordered card (GitHub-style box); the whole card is the link -->
<a
	href={`/projects/${project.id}/`}
	class="group flex h-full flex-col overflow-hidden rounded-xl border bg-card text-card-foreground transition-colors hover:border-muted-foreground/50"
>
	{
		heroImage && (
			<Image
				src={heroImage}
				width={720}
				height={360}
				alt=""
				loading={eager ? 'eager' : 'lazy'}
				class="aspect-2/1 w-full border-b object-cover"
			/>
		)
	}
	<div class="flex flex-1 flex-col gap-1.5 p-4">
		<!-- E.g. Android Application, Progressive Web Application, etc. -->
		<p class="text-xs text-muted-foreground">{type}</p>
		
		<Heading class="text-base font-bold group-hover:text-link group-hover:underline">{title}</Heading>
		
		<p class="text-sm text-muted-foreground">{description}</p>
		
		<!-- Plain text, not chips: chips are kept for the project page's tech stack -->
		<p class="mt-auto pt-3 text-xs text-muted-foreground">{techStack.join(' · ')}</p>
	</div>
</a>
