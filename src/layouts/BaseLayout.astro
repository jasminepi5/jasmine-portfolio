---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = {
	title: string;
	description: string;
	image?: ImageMetadata;
};

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="flex min-h-screen flex-col">
		<!-- First thing a keyboard user reaches: jumps past the header links. Hidden until focused. -->
		<a
			href="#main"
			class="sr-only rounded-lg bg-primary text-sm font-bold text-primary-foreground focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2"
		>
			Skip to content
		</a>
		<Header />
		<!-- Same max width and gutters as the header and footer, so all edges line up -->
		<main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 md:py-14 lg:px-8">
			<slot />
		</main>
		<Footer />
	</body>
</html>
