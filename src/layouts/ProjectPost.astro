---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'project'>['data'];

const {
	title,
	description,
	type,
	location,
	techStack,
	githubLink,
	liveDemoLink,
	pubDate,
	updatedDate,
	heroImage,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}

			.hero-image {
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}

			/* Header: title, subtitle, dates */
			.title {
				margin-bottom: 1.5em;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.25em;
			}
			.subtitle {
				margin: 0;
				font-size: 1.125em;
				line-height: 1.4;
				opacity: 0.7;
			}
			.date {
				margin-top: 0.75em;
				color: rgb(var(--gray));
				font-style: italic;
			}

			/* Overview: description, details, links */
			.overview {
				margin-bottom: 2em;
			}
			.description {
				margin: 0 0 1em;
			}
			.details {
				list-style: none;
				padding: 0;
				margin: 0 0 1.5em;
				display: flex;
				flex-direction: column;
				gap: 0.25em;
			}
			.label {
				font-weight: 600;
			}

			.tech-list {
				list-style: none;
				padding: 0;
				margin: 0.25em 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.tech-chip {
				padding: 0.25em 0.75em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.875em;
				line-height: 1.5;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
			}
			.button {
				display: inline-block;
				padding: 0.5em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				color: inherit;
				text-decoration: none;
			}
			.button:hover {
				background: rgb(var(--gray-light));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<header class="title">
						<h1>{title}</h1>
						<p class="subtitle">{description}</p>
						<div class="date">
							<div>Published on <FormattedDate date={pubDate} /></div>
							{updatedDate && <div>Last updated on <FormattedDate date={updatedDate} /></div>}
						</div>
					</header>

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={title} />
						</div>
					)}

					<section class="overview">
						<ul class="details">
							<li><span class="label">Product type:</span> {type}</li>
							{location && <li><span class="label">Location:</span> {location}</li>}
							<li>
								<span class="label">Tech stack:</span>
								<ul class="tech-list">
									{techStack.map((tech) => <li class="tech-chip">{tech}</li>)}
								</ul>
							</li>
						</ul>

						{(githubLink || liveDemoLink) && (
							<div class="links">
								{githubLink && (
									<a class="button" href={githubLink} target="_blank" rel="noopener noreferrer">GitHub</a>
								)}
								{liveDemoLink && (
									<a class="button" href={liveDemoLink} target="_blank" rel="noopener noreferrer">Live demo</a>
								)}
							</div>
						)}
					</section>

					<hr />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>