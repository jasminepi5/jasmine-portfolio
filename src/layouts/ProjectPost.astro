---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { badgeClass, buttonClass } from '@/lib/ui';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'project'>['data'];

const {
	title,
	description,
	type,
	location,
	techStack,
	githubLink,
	liveDemoLink,
	pubDate,
	updatedDate,
	heroImage,
} = Astro.props;
---

<BaseLayout title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage}>
	<a href="/projects/" class="inline-flex items-center gap-1 text-sm text-link hover:underline">
		<Icon name="lucide:arrow-left" class="size-4" />
		All projects
	</a>

	<header class="mt-6">
		<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
		<p class="mt-2 text-lg text-muted-foreground">{description}</p>
	</header>

	{
		heroImage && (
			<Image
				src={heroImage}
				width={1600}
				height={800}
				alt=""
				loading="eager"
				class="mt-8 aspect-2/1 w-full rounded-xl border object-cover"
			/>
		)
	}

	<!-- Like a GitHub repo page: write-up on the left, "About" sidebar on the right (above it on mobile) -->
	<div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
		<aside class="lg:order-last">
			<div class="rounded-xl border p-4 lg:sticky lg:top-20">
				<h2 class="text-sm font-bold">About</h2>
				<dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2 text-sm">
					<dt class="text-muted-foreground">Type</dt>
					<dd>{type}</dd>
					{
						location && (
							<>
								<dt class="text-muted-foreground">Location</dt>
								<dd>{location}</dd>
							</>
						)
					}
					<dt class="text-muted-foreground">Published</dt>
					<dd><FormattedDate date={pubDate} /></dd>
					{
						updatedDate && (
							<>
								<dt class="text-muted-foreground">Updated</dt>
								<dd><FormattedDate date={updatedDate} /></dd>
							</>
						)
					}
				</dl>

				<h3 class="mt-5 text-sm font-bold">Tech stack</h3>
				<ul class="mt-2 flex flex-wrap gap-1.5">
					{techStack.map((tech) => <li class={badgeClass({ variant: 'secondary' })}>{tech}</li>)}
				</ul>

				{
					(githubLink || liveDemoLink) && (
						<div class="mt-5 flex flex-wrap gap-2 border-t pt-4">
							{githubLink && (
								<a
									href={githubLink}
									target="_blank"
									rel="noopener noreferrer"
									aria-label="GitHub"
									data-tooltip="GitHub"
									class={buttonClass({ variant: 'outline', size: 'icon-lg' })}
								>
									<Icon name="simple-icons:github" class="size-5" />
								</a>
							)}
							{liveDemoLink && (
								<a
									href={liveDemoLink}
									target="_blank"
									rel="noopener noreferrer"
									class={buttonClass({ size: 'lg' })}
								>
									Live demo
									<Icon name="lucide:external-link" />
								</a>
							)}
						</div>
					)
				}
			</div>
		</aside>

		<article class="prose max-w-3xl prose-headings:tracking-tight prose-img:rounded-xl prose-img:border">
			<slot />
		</article>
	</div>
</BaseLayout>
