---
import { buttonClass } from '@/lib/ui';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Page not found | ${SITE_TITLE}`} description="This page doesn't exist." noIndex>
	<div class="flex flex-col items-start gap-4 py-10">
		<p class="text-sm font-bold text-muted-foreground">404</p>
		<h1 class="text-3xl font-bold tracking-tight md:text-4xl">Page not found</h1>
		<p class="text-muted-foreground">The page you're looking for doesn't exist or has moved.</p>
		<div class="flex flex-wrap gap-2">
			<a href="/" class={buttonClass({ size: 'lg' })}>Back to home</a>
			<a href="/projects/" class={buttonClass({ variant: 'outline', size: 'lg' })}>See projects</a>
		</div>
	</div>
</BaseLayout>
