---
import { getCollection } from 'astro:content';
import { buttonClass } from '@/lib/ui';
import Icon from '../components/Icon.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { SITE_TITLE } from '../consts';
import { skillGroups } from '../data/skills';
import BaseLayout from '../layouts/BaseLayout.astro';

// Newest first, then split by section (filter keeps the sorted order)
const timelineItems = (await getCollection('timelineItem')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const sections = [
	{ title: 'Education', items: timelineItems.filter((item) => item.data.section === 'Education') },
	{ title: 'Experience', items: timelineItems.filter((item) => item.data.section === 'Experience') },
];
---

<BaseLayout title={`About | ${SITE_TITLE}`} description="My education, experience and the tools I use.">
	<div class="flex flex-wrap items-center justify-between gap-4">
		<h1 class="text-3xl font-bold tracking-tight md:text-4xl">My Journey So Far</h1>
		<a href="/cv.pdf" download class={buttonClass({ variant: 'outline', size: 'lg' })}>
			<Icon name="lucide:download" />
			Download CV
		</a>
	</div>

	<!-- Draft intro: rewrite in your own words -->
	<div class="mt-6 max-w-prose space-y-4 leading-relaxed text-muted-foreground">
		<p>
			I'm a Computer Science graduate from Monash University, where I majored in Algorithms &amp;
			Software. Before that I completed a Diploma of Information Technology at Monash College.
		</p>
		<p>
			I like building software that people use day to day, and I enjoy working across the stack, from
			database design to the screens users actually see.
		</p>
	</div>

	<section class="mt-14" aria-labelledby="skills-heading">
		<h2 id="skills-heading" class="mb-6 text-sm font-bold tracking-widest text-muted-foreground uppercase">
			Skills &amp; Tools
		</h2>
		<div class="grid gap-6 sm:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div>
						<h3 class="mb-3 text-sm font-bold">{group.title}</h3>
						<ul class="flex flex-wrap gap-2">
							{group.skills.map(({ name, icon }) => (
								<li>
									<!-- Not focusable (it isn't interactive); screen readers read the name from aria-label -->
									<span
										role="img"
										aria-label={name}
										data-tooltip={name}
										class="flex size-12 items-center justify-center rounded-lg border bg-card text-muted-foreground transition-colors hover:text-foreground"
									>
										<Icon name={icon} class="size-6" />
									</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	{
		sections.map(
			({ title, items }) =>
				items.length > 0 && (
					<section class="mt-14">
						<h2 class="mb-6 text-sm font-bold tracking-widest text-muted-foreground uppercase">{title}</h2>
						<ol>
							{items.map((item) => (
								<TimelineItem {...item.data} />
							))}
						</ol>
					</section>
				),
		)
	}
</BaseLayout>
