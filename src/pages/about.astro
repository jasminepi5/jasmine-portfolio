---
import { getCollection } from 'astro:content';
import { buttonClass } from '@/lib/ui';
import Icon from '../components/Icon.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { CV_FILENAME, CV_URL, SITE_TITLE } from '../consts';
import { skillGroups } from '../data/skills';
import BaseLayout from '../layouts/BaseLayout.astro';

// Newest first, then split by section (filter keeps the sorted order)
const timelineItems = (await getCollection('timelineItem')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const sections = [
	{ title: 'Education', items: timelineItems.filter((item) => item.data.section === 'Education') },
	{ title: 'Experience', items: timelineItems.filter((item) => item.data.section === 'Experience') },
];
---

<BaseLayout title={`About | ${SITE_TITLE}`} description="My education, experience and the tools I use.">
	
	<!-- HEADER = H1 + DOWNLOAD CV BUTTON -->
	
	<div class="flex flex-wrap items-center justify-between gap-4">

		<h1 class="text-3xl font-bold tracking-tight md:text-4xl">My Journey So Far</h1>
		
		<a 
		href={CV_URL} 
		download={CV_FILENAME} 
		class={buttonClass({ variant: 'outline', size: 'lg' })} 
		data-tooltip="Download as PDF">
			<Icon name="lucide:download" />
			Download CV
		</a>
	</div>

	<!-- INTRO PARAGRAPH(S) -->

	<div class="mt-6 max-w-prose space-y-4 leading-relaxed text-muted-foreground">
		<p>
			I'm a Computer Science graduate from Monash University, where I majored in Algorithms &amp;
			Software. Before that, I completed a Diploma of Information Technology at Monash College.
		</p>
		<!-- <p>
			Although my education background is mainly in Computer Science &amp; Software Engineering, 
			I'm open to learning things	adjacent to <em>and</em> outside of my domain.
		</p> -->
	</div>

	<!-- SKILLS AND TOOLS SECTION -->

	<!-- Display skills and tools as icons (e.g. Python programming language has Python logo/icon) -->

	<section class="mt-14" aria-labelledby="skills-heading">
		<h2 id="skills-heading" class="mb-6 border-b pb-3 text-sm font-bold tracking-widest text-muted-foreground uppercase">
			Skills &amp; Tools
		</h2>
		<div class="grid gap-6 sm:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div>
						<h3 class="mb-3 text-sm font-bold">{group.title}</h3>
						<ul class="flex flex-wrap gap-2">
							{group.skills.map(({ name, icon }) => (
								<li class="flex w-18 flex-col items-center gap-1 text-center">
									<!-- Fixed width so wrapped names (e.g. "Android Studio") stay centred under the icon -->
									<span class="flex size-12 items-center justify-center rounded-lg border bg-card text-muted-foreground">
										<Icon name={icon} class="size-6" />
									</span>
									<span class="text-[11px] leading-tight text-muted-foreground">{name}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- TIMELINE SECTION -->

	<!-- Displays timeline graph thingy like on LinkedIn -->

	{
		sections.map(
			({ title, items }) =>
				items.length > 0 && (
					<section class="mt-14">
						<h2 class="mb-6 border-b pb-3 text-sm font-bold tracking-widest text-muted-foreground uppercase">{title}</h2>
						<ol>
							{items.map((item) => (
								<TimelineItem {...item.data} />
							))}
						</ol>
					</section>
				),
		)
	}
</BaseLayout>
