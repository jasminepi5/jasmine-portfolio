---
import { buttonClass } from '@/lib/ui';
import Icon from '../components/Icon.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

// Show URLs without the protocol and trailing slash, e.g. "github.com/jasminepi5"
const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const links = [
	{ label: 'Email', icon: 'lucide:mail', href: `mailto:${EMAIL}`, text: EMAIL, external: false },
	{ label: 'LinkedIn', icon: 'fa6-brands:linkedin', href: LINKEDIN_URL, text: displayUrl(LINKEDIN_URL), external: true },
	{ label: 'GitHub', icon: 'simple-icons:github', href: GITHUB_URL, text: displayUrl(GITHUB_URL), external: true },
] as const;
---

<BaseLayout title={`Contact | ${SITE_TITLE}`} description="How to get in touch with me.">
	<div class="max-w-xl">
		<h1 class="text-3xl font-bold tracking-tight md:text-4xl">Contact</h1>
		<p class="mt-3 leading-relaxed text-muted-foreground">
			I'm open to graduate and junior developer roles in Melbourne. Email is the quickest way to reach me.
		</p>

		<!-- GitHub-style list box. The icon replaces the text label; its tooltip shows the label. -->
		<ul class="mt-8 divide-y rounded-xl border">
			{
				links.map(({ label, icon, href, text, external }) => (
					<li class="flex items-center gap-4 px-4 py-3">
						<span data-tooltip={label} class="flex shrink-0 text-foreground">
							<Icon name={icon} class="size-5" />
							<span class="sr-only">{label}:</span>
						</span>
						<a
							href={href}
							class="text-link wrap-anywhere hover:underline"
							{...(external && { target: '_blank', rel: 'noopener noreferrer' })}
						>
							{text}
						</a>
						{label === 'Email' && (
							// Hidden until the script confirms the Clipboard API is available
							<button
								type="button"
								data-copy-email={EMAIL}
								aria-label="Copy email"
								data-tooltip="Copy email"
								data-tooltip-align="end"
								hidden
								class:list={['group ml-auto', buttonClass({ variant: 'ghost', size: 'icon' })]}
							>
								<Icon name="lucide:copy" class="size-4 group-data-copied:hidden" />
								<Icon name="lucide:check" class="hidden size-4 text-link group-data-copied:block" />
							</button>
						)}
					</li>
				))
			}
		</ul>

		<a href="/cv.pdf" download class:list={['mt-8', buttonClass({ variant: 'outline', size: 'lg' })]}>
			<Icon name="lucide:download" />
			Download CV
		</a>
		<p role="status" class="sr-only" data-copy-status></p>
	</div>
</BaseLayout>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
	const status = document.querySelector<HTMLElement>('[data-copy-status]');

	if (button && navigator.clipboard) {
		button.hidden = false;
		let timer: ReturnType<typeof setTimeout>;

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
			} catch {
				return;
			}
			// data-copied swaps the copy icon for a check; the status line is read out by screen readers
			button.dataset.copied = '';
			button.dataset.tooltip = 'Copied';
			if (status) status.textContent = 'Email address copied';
			clearTimeout(timer);
			timer = setTimeout(() => {
				delete button.dataset.copied;
				button.dataset.tooltip = 'Copy email';
				if (status) status.textContent = '';
			}, 2000);
		});
	}
</script>
