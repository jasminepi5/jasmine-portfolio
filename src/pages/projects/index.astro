---
import { getPublishedProjects } from '@/lib/projects';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Featured first, then newest (drafts hidden in production)
const projects = await getPublishedProjects();
---

<BaseLayout title={`Projects | ${SITE_TITLE}`} description="Software projects I've built.">
	<h1 class="text-3xl font-bold tracking-tight md:text-4xl">Projects</h1>
	
	<p class="mt-2 text-muted-foreground">
		Projects I've done so far, from a university team project to an app for a real business.
	</p>

	<ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			projects.map((project, index) => (
				<li>
					<!-- The first row is on screen at load, so its images load straight away -->
					<ProjectCard project={project} headingLevel={2} eager={index < 3} />
				</li>
			))
		}
	</ul>
</BaseLayout>
